#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require_relative 'lib/grimoire'

# Bridges lich-5's 5s accept-loop rebind sleep (the --detachable-client
# error path in its main.rb) -- 4 attempts * 3s comfortably straddles one
# rebind cycle without hanging a genuinely dead session too long before
# reporting failure. Only used in --character discovery mode; manual
# --host/--port has no session file to re-resolve against, so a
# ConnectError there stays unretried, same as before this flag existed.
DISCOVERY_CONNECT_RETRIES = 4
DISCOVERY_CONNECT_BACKOFF = 3

options = { host: '127.0.0.1', port: nil, character: nil, list: false, autolog: false, log_dir: 'logs', config: nil }

OptionParser.new do |parser|
  parser.banner =
    'Usage: grimoire --character NAME | --port PORT [--host HOST] [--autolog] [--log-dir DIR] [--config PATH] | --list'
  parser.on('--list', "List characters with an active Lich session file, then exit (see --character)") { options[:list] = true }
  parser.on('--character NAME', "Character name -- locate Lich's host/port from its session file instead of --host/--port") do |name|
    options[:character] = name
  end
  parser.on('--host HOST', 'Lich frontend-port host (default 127.0.0.1, ignored with --character)') { |host| options[:host] = host }
  parser.on('--port PORT', Integer, 'Lich frontend-port port, from --detachable-client') { |port| options[:port] = port }
  parser.on('--autolog', 'Log the raw feed and parsed narrative output to timestamped files under DIR (default logs/)') do
    options[:autolog] = true
  end
  parser.on('--log-dir DIR', 'Directory for --autolog output (default logs/)') { |dir| options[:log_dir] = dir }
  parser.on('--config PATH', 'Theme/settings YAML file (default ./configs/config.yml, then ~/.config/grimoire/config.yml)') do |path|
    options[:config] = path
  end
end.parse!(ARGV)

if options[:list]
  sessions = Grimoire::SessionLocator.list
  if sessions.empty?
    puts "No Lich sessions found in #{Grimoire::SessionLocator::SESSION_DIR}"
  else
    sessions.each do |session|
      puts session.valid? ? "#{session.character}\t#{session.host}:#{session.port}" : "#{session.character}\t(#{session.error})"
    end
  end
  exit 0
end

if options[:port] && options[:character]
  warn 'grimoire: both --character and --port given; using --host/--port and ignoring --character'
  options[:character] = nil
end

# No --character/--port is a valid launch now: grimoire opens its shell with
# no session attached, and sessions are started from the Session menu. When
# one is given it is pre-attached as the first tab rather than being a
# separate, shell-free code path.
theme =
  begin
    Grimoire::Config.load(options[:config])
  rescue Grimoire::Config::Error => e
    warn "grimoire: #{e.message} -- using default theme"
    Grimoire::Theme::DEFAULT
  end

Grimoire::Fonts.load_bundled!

shell = Grimoire::Shell.new(theme: theme, autolog: options[:autolog], log_dir: options[:log_dir])

# Re-resolves the session file on every attempt, not just the TCP connect --
# on lich-5's rebind cycle the port itself changes, so retrying against the
# stale port already in hand would never succeed.
#
# This whole retry loop stays here at launch rather than moving into Shell:
# it sleeps between attempts, which is fine before the GTK main loop is
# running but would freeze the UI if a menu action did it. Shell#attach
# deliberately raises instead, leaving the menu free to report failure in a
# dialog.
def attach_with_discovery(shell, character)
  attempts = 0
  begin
    attempts += 1
    host_port = Grimoire::SessionLocator.new(character).locate
    shell.attach(host: host_port[:host], port: host_port[:port], character: character)
  rescue Grimoire::SessionLocator::NotFound, Grimoire::SessionLocator::InvalidSession => e
    warn "grimoire: #{e.message}"
    exit 1
  rescue Grimoire::Connection::ConnectError => e
    if attempts < DISCOVERY_CONNECT_RETRIES
      warn "grimoire: #{e.message} -- retrying (lich-5 may be mid-reconnect), attempt #{attempts}/#{DISCOVERY_CONNECT_RETRIES}"
      sleep DISCOVERY_CONNECT_BACKOFF
      retry
    end
    warn "grimoire: could not connect to Lich for '#{character}' after #{attempts} attempts: #{e.message}"
    exit 1
  end
end

if options[:character]
  attach_with_discovery(shell, options[:character])
elsif options[:port]
  begin
    shell.attach(host: options[:host], port: options[:port])
  rescue Grimoire::Connection::ConnectError => e
    warn "grimoire: #{e.message}"
    exit 1
  end
end

shell.run
